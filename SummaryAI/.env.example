# --- Summary AI configuration ---------------------------------------------
# Copy this file to `.env` and fill in your key. `.env` is git-ignored.

# Required. Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional. Any model ending in `:free` costs nothing.
# NOTE: OpenRouter retires free models without notice. Verify any model id at
# https://openrouter.ai/models?order=newest before using it. The app
# automatically falls back to another model when one returns 404 or 429.
# Verified working: nvidia/nemotron-3-super-120b-a12b:free (default)
#                  inclusionai/ling-3.0-flash-sante:free
#                  nvidia/nemotron-3.5-lightning:free  (1M context)
#                  apodex/apodex-1.1-mini:free
#                  google/gemma-4-31b-it:free
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional. Attribution headers shown on your OpenRouter dashboard.
OPENROUTER_APP_URL=http://localhost:8501
OPENROUTER_APP_TITLE=Summary AI
