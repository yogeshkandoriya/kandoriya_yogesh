# OpenRouter API Key for Summary AI Bot
# Get a free key at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Primary Model
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Fallback Models (comma-separated, used automatically if primary is rate-limited)
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free
